# ============================================================================
# Common Configuration
# ============================================================================

# ============================================================================
# Storage Backend Configuration (v2.0 Multi-Backend Support)
# ============================================================================
# Flash FAT (Internal Flash with Wear Leveling)
CONFIG_UART_FILEBRIDGE_BACKEND_FLASH_FAT=y

# LittleFS (Power-resilient Flash filesystem)
CONFIG_UART_FILEBRIDGE_BACKEND_LITTLEFS=y

# SPIFFS (Internal Flash flat filesystem)
CONFIG_UART_FILEBRIDGE_BACKEND_SPIFFS=y

# ============================================================================
# UART File Bridge Base Configuration
# ============================================================================
CONFIG_UART_FILEBRIDGE_BAUD=3000000
CONFIG_UART_FILEBRIDGE_FLASH_FAT_MAX_FILES=5
CONFIG_UART_FILEBRIDGE_FLASH_FAT_MOUNT_POINT="/flash"
CONFIG_UART_FILEBRIDGE_FLASH_FAT_PARTITION="flash"
CONFIG_UART_FILEBRIDGE_LITTLEFS_MAX_FILES=5
CONFIG_UART_FILEBRIDGE_LITTLEFS_MOUNT_POINT="/lfs"
CONFIG_UART_FILEBRIDGE_LITTLEFS_PARTITION="littlefs"
CONFIG_UART_FILEBRIDGE_SD_MAX_FILES=5

# SD Card
CONFIG_UART_FILEBRIDGE_SD_MOUNT_POINT="/sd"
CONFIG_UART_FILEBRIDGE_SPIFFS_MAX_FILES=5
CONFIG_UART_FILEBRIDGE_SPIFFS_MOUNT_POINT="/spiffs"
CONFIG_UART_FILEBRIDGE_SPIFFS_PARTITION="spiffs"
